<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Vishal Kumar — Data Analyst & AI Engineer</title>
<meta name="description" content="Vishal Kumar — Data Analyst, Python Developer, Aspiring AI Engineer. Analyzed 500K+ records, reduced reporting time by 40%."/>
<meta property="og:title" content="Vishal Kumar — Data Analyst"/>
<meta property="og:description" content="Portfolio of Vishal Kumar — Data Analyst, AI Enthusiast, Python Developer"/>
<meta property="og:type" content="website"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#030712;--bg2:#060e1e;--bg3:#0a1628;
  --c1:#6366f1;--c1l:#818cf8;--c1ll:#c7d2fe;
  --c2:#06b6d4;--c2l:#67e8f9;
  --c3:#f472b6;
  --text:#f1f5f9;--text2:#94a3b8;--text3:#475569;
  --border:rgba(99,102,241,0.15);--glow:rgba(99,102,241,0.4);
}
html{scroll-behavior:smooth}
body{font-family:'Space Grotesk',sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden;cursor:none}

/* CURSOR */
#cursor{position:fixed;width:12px;height:12px;background:var(--c1l);border-radius:50%;pointer-events:none;z-index:99999;transform:translate(-50%,-50%);transition:width .3s,height .3s;mix-blend-mode:screen}
#cursor-ring{position:fixed;width:40px;height:40px;border:1px solid rgba(99,102,241,.5);border-radius:50%;pointer-events:none;z-index:99998;transform:translate(-50%,-50%);transition:width .3s,height .3s}

/* SCROLL PROGRESS */
#prog{position:fixed;top:0;left:0;height:2px;z-index:9999;background:linear-gradient(90deg,var(--c1),var(--c2),var(--c3));width:0%;transition:width .1s}

/* CANVAS */
#bgCanvas{position:fixed;inset:0;z-index:0;opacity:.5}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:1000;padding:1.25rem 3rem;display:flex;align-items:center;justify-content:space-between;transition:all .4s}
nav.scrolled{background:rgba(3,7,18,.9);backdrop-filter:blur(24px);border-bottom:1px solid var(--border);padding:1rem 3rem}
.nav-logo{font-family:'JetBrains Mono',monospace;font-size:1rem;font-weight:500;color:var(--c1l);letter-spacing:.05em}
.nav-logo span{color:var(--text3)}
.nav-links{display:flex;gap:2rem;list-style:none}
.nav-links a{color:var(--text2);text-decoration:none;font-size:.82rem;font-family:'JetBrains Mono',monospace;letter-spacing:.05em;transition:color .3s;position:relative}
.nav-links a:hover{color:var(--c1l)}
.nav-btn{padding:.55rem 1.4rem;border-radius:6px;border:1px solid var(--c1);background:transparent;color:var(--c1l);font-family:'JetBrains Mono',monospace;font-size:.78rem;cursor:none;transition:all .3s;text-decoration:none}
.nav-btn:hover{background:rgba(99,102,241,.15);box-shadow:0 0 20px var(--glow)}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:none;padding:.5rem}
.hamburger span{display:block;width:22px;height:2px;background:var(--text);transition:.3s}
.mob-menu{display:none;position:fixed;inset:0;z-index:999;background:rgba(3,7,18,.97);backdrop-filter:blur(20px);flex-direction:column;align-items:center;justify-content:center;gap:2rem}
.mob-menu.open{display:flex}
.mob-menu a{color:var(--text);text-decoration:none;font-family:'JetBrains Mono',monospace;font-size:1.4rem;transition:color .3s}
.mob-menu a:hover{color:var(--c1l)}
.mob-close{position:absolute;top:1.5rem;right:1.5rem;background:none;border:none;color:var(--text);font-size:1.5rem;cursor:pointer}

/* HERO */
#hero{min-height:100vh;display:flex;align-items:center;position:relative;z-index:1;padding:8rem 3rem 4rem;overflow:hidden}
.hero-wrap{max-width:1300px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 440px;gap:5rem;align-items:center}
.hero-eyebrow{display:flex;align-items:center;gap:.75rem;margin-bottom:1.5rem;opacity:0;animation:slideUp .8s .2s forwards}
.eyebrow-line{width:36px;height:1px;background:var(--c1l)}
.eyebrow-text{font-family:'JetBrains Mono',monospace;font-size:.75rem;color:var(--c1l);letter-spacing:.15em;text-transform:uppercase}
h1.hero-name{font-size:clamp(3rem,6vw,5.5rem);font-weight:700;line-height:1.05;letter-spacing:-.02em;opacity:0;animation:slideUp .8s .35s forwards}
.hero-name .outline{-webkit-text-stroke:1px rgba(255,255,255,.25);color:transparent}
.hero-name .filled{background:linear-gradient(135deg,#fff 0%,var(--c1ll) 50%,var(--c2l) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero-roles{display:flex;flex-wrap:wrap;align-items:center;gap:.75rem;margin:1.5rem 0;font-size:1rem;color:var(--text2);opacity:0;animation:slideUp .8s .5s forwards}
.role-sep{color:var(--c1);opacity:.4}
.role-active{color:var(--c1l);font-weight:600}
.hero-desc{color:var(--text2);font-size:1rem;line-height:1.85;max-width:520px;margin-bottom:2.5rem;opacity:0;animation:slideUp .8s .65s forwards}
.hero-desc strong{color:var(--text)}
.hero-cta{display:flex;gap:1rem;flex-wrap:wrap;opacity:0;animation:slideUp .8s .8s forwards}
.cta-primary{display:inline-flex;align-items:center;gap:.6rem;padding:.88rem 2rem;border-radius:8px;background:var(--c1);color:#fff;text-decoration:none;font-weight:600;font-size:.92rem;transition:all .3s;position:relative;overflow:hidden}
.cta-primary::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent,rgba(255,255,255,.15));transform:translateX(-100%);transition:transform .4s}
.cta-primary:hover::before{transform:translateX(0)}
.cta-primary:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(99,102,241,.5)}
.cta-secondary{display:inline-flex;align-items:center;gap:.6rem;padding:.88rem 2rem;border-radius:8px;border:1px solid rgba(255,255,255,.1);color:var(--text);text-decoration:none;font-size:.92rem;transition:all .3s;background:rgba(255,255,255,.03)}
.cta-secondary:hover{border-color:var(--c1);color:var(--c1l);transform:translateY(-2px)}
.hero-stats{display:flex;gap:2.5rem;margin-top:3rem;padding-top:2rem;border-top:1px solid var(--border);opacity:0;animation:slideUp .8s .95s forwards;flex-wrap:wrap}
.stat-n{font-size:1.9rem;font-weight:700;background:linear-gradient(135deg,var(--c1l),var(--c2l));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.stat-l{font-size:.7rem;color:var(--text3);margin-top:.15rem;font-family:'JetBrains Mono',monospace;letter-spacing:.05em}

/* HERO CARD */
.hero-visual{opacity:0;animation:fadeIn 1.2s .5s forwards}
.card-3d{transform-style:preserve-3d;transition:transform .12s ease-out}
.profile-card{background:linear-gradient(135deg,rgba(15,23,42,.95),rgba(10,22,40,.98));border:1px solid var(--border);border-radius:24px;padding:2.25rem;position:relative;overflow:hidden}
.profile-card::after{content:'';position:absolute;top:-60%;left:-60%;width:220%;height:220%;background:conic-gradient(from 0deg,transparent 330deg,rgba(99,102,241,.12) 360deg);animation:rotateBorder 7s linear infinite;pointer-events:none}
@keyframes rotateBorder{to{transform:rotate(360deg)}}
.card-inner{position:relative;z-index:1}
.avatar{width:90px;height:90px;border-radius:18px;background:linear-gradient(135deg,var(--c1),var(--c2));display:flex;align-items:center;justify-content:center;font-size:2.2rem;font-weight:700;color:#fff;margin-bottom:1.4rem;position:relative}
.avatar-badge{position:absolute;bottom:-5px;right:-5px;width:20px;height:20px;border-radius:50%;background:#22c55e;border:3px solid var(--bg)}
.card-name{font-size:1.25rem;font-weight:700;margin-bottom:.2rem}
.card-role{font-size:.8rem;color:var(--c1l);font-family:'JetBrains Mono',monospace;margin-bottom:1.4rem}
.card-chips{display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:1.5rem}
.chip{padding:.28rem .75rem;border-radius:6px;font-size:.72rem;background:rgba(99,102,241,.12);color:var(--c1l);border:1px solid rgba(99,102,241,.2);font-family:'JetBrains Mono',monospace}
.chip.c{background:rgba(6,182,212,.1);color:var(--c2l);border-color:rgba(6,182,212,.2)}
.chip.p{background:rgba(244,114,182,.1);color:#f9a8d4;border-color:rgba(244,114,182,.2)}
.card-grid{display:grid;grid-template-columns:1fr 1fr;gap:.65rem}
.cg-item{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);border-radius:12px;padding:.8rem}
.cg-val{font-size:1.3rem;font-weight:700;background:linear-gradient(135deg,var(--c1l),var(--c2l));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.cg-key{font-size:.65rem;color:var(--text3);font-family:'JetBrains Mono',monospace;margin-top:.1rem}
.float-card{position:absolute;background:rgba(6,14,30,.92);border:1px solid var(--border);border-radius:12px;padding:.65rem 1rem;font-size:.75rem;backdrop-filter:blur(20px);display:flex;align-items:center;gap:.5rem;white-space:nowrap;font-family:'JetBrains Mono',monospace}
.fc1{top:-18px;right:-30px;animation:floatA 4s ease-in-out infinite}
.fc2{bottom:30px;left:-45px;animation:floatB 5s ease-in-out infinite}
.fc3{top:45%;right:-55px;animation:floatA 3.5s 1s ease-in-out infinite}
@keyframes floatA{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@keyframes floatB{0%,100%{transform:translateY(0)}50%{transform:translateY(8px)}}
.fc-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}

/* SECTIONS */
section{position:relative;z-index:1;padding:8rem 3rem}
.sec-wrap{max-width:1300px;margin:0 auto}
.sec-tag{font-family:'JetBrains Mono',monospace;font-size:.72rem;color:var(--c1l);letter-spacing:.15em;text-transform:uppercase;display:flex;align-items:center;gap:.75rem;margin-bottom:1rem}
.sec-tag::before{content:'';width:28px;height:1px;background:var(--c1l)}
h2.sec-title{font-size:clamp(2.2rem,4vw,3.5rem);font-weight:700;letter-spacing:-.02em;line-height:1.1;margin-bottom:1.25rem}
h2.sec-title span{background:linear-gradient(135deg,var(--c1l),var(--c2l));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.sec-sub{color:var(--text2);font-size:1rem;max-width:560px;margin-bottom:4rem;line-height:1.8}

/* ABOUT - BENTO */
#about{background:var(--bg2)}
.bento{display:grid;grid-template-columns:repeat(12,1fr);gap:1.2rem}
.bc{background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.06);border-radius:20px;padding:1.85rem;transition:all .4s;position:relative;overflow:hidden}
.bc::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at var(--mx,50%) var(--my,50%),rgba(99,102,241,.07),transparent 55%);opacity:0;transition:opacity .4s}
.bc:hover::before{opacity:1}
.bc:hover{border-color:rgba(99,102,241,.22);transform:translateY(-2px)}
.bc-7{grid-column:span 7}.bc-5{grid-column:span 5}.bc-4{grid-column:span 4}.bc-6{grid-column:span 6}.bc-12{grid-column:span 12}
.bc-ico{width:42px;height:42px;border-radius:12px;background:rgba(99,102,241,.14);display:flex;align-items:center;justify-content:center;font-size:1.25rem;margin-bottom:1.2rem}
.bc-ico.c{background:rgba(6,182,212,.12)}.bc-ico.p{background:rgba(244,114,182,.12)}.bc-ico.g{background:rgba(34,197,94,.12)}
.bc-lbl{font-size:.68rem;color:var(--text3);font-family:'JetBrains Mono',monospace;letter-spacing:.1em;text-transform:uppercase;margin-bottom:.4rem}
.bc-big{font-size:2.4rem;font-weight:700;background:linear-gradient(135deg,var(--c1l),var(--c2l));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;margin-bottom:.3rem}
.bc-h{font-size:1.05rem;font-weight:600;margin-bottom:.5rem}
.bc-p{font-size:.86rem;color:var(--text2);line-height:1.75}
.pills{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.85rem}
.pill{padding:.3rem .85rem;border-radius:50px;font-size:.75rem;background:rgba(99,102,241,.1);color:var(--c1l);border:1px solid rgba(99,102,241,.15)}
.pill.c{background:rgba(6,182,212,.09);color:var(--c2l);border-color:rgba(6,182,212,.15)}
.pill.p{background:rgba(244,114,182,.09);color:#f9a8d4;border-color:rgba(244,114,182,.15)}

/* SKILLS */
#skills{background:var(--bg)}
.skills-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}
.sg{background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.06);border-radius:20px;padding:2rem;transition:border-color .4s}
.sg:hover{border-color:rgba(99,102,241,.2)}
.sg-hd{display:flex;align-items:center;gap:.75rem;margin-bottom:1.75rem}
.sg-ico{width:36px;height:36px;border-radius:10px;background:rgba(99,102,241,.14);display:flex;align-items:center;justify-content:center;font-size:1rem}
.sg-t{font-size:.95rem;font-weight:600}
.sk{margin-bottom:1.15rem}
.sk-top{display:flex;justify-content:space-between;margin-bottom:.45rem}
.sk-n{font-size:.86rem;color:var(--text2)}
.sk-p{font-size:.76rem;color:var(--c1l);font-family:'JetBrains Mono',monospace}
.sk-bar{height:3px;background:rgba(255,255,255,.05);border-radius:2px;overflow:hidden}
.sk-fill{height:100%;border-radius:2px;transform:scaleX(0);transform-origin:left;transition:transform 1.4s cubic-bezier(.16,1,.3,1);background:linear-gradient(90deg,var(--c1),var(--c2))}

/* PROJECTS */
#projects{background:var(--bg2)}
.proj-filters{display:flex;gap:.5rem;margin-bottom:3rem;flex-wrap:wrap}
.pf{padding:.48rem 1.2rem;border-radius:8px;border:1px solid rgba(255,255,255,.08);background:transparent;color:var(--text2);font-family:'JetBrains Mono',monospace;font-size:.76rem;cursor:none;transition:all .3s;letter-spacing:.03em}
.pf.on,.pf:hover{background:rgba(99,102,241,.14);border-color:var(--c1);color:var(--c1l)}
.proj-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(350px,1fr));gap:1.4rem}
.pc{background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.06);border-radius:20px;overflow:hidden;transition:all .4s;display:flex;flex-direction:column;position:relative}
.pc::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(99,102,241,.04),transparent);opacity:0;transition:opacity .4s}
.pc:hover{transform:translateY(-6px);border-color:rgba(99,102,241,.3);box-shadow:0 24px 60px rgba(0,0,0,.5)}
.pc:hover::before{opacity:1}
.pc.hidden{display:none}
.pc-top{padding:2rem 2rem .75rem;display:flex;align-items:flex-start;justify-content:space-between}
.pc-emoji{font-size:2.4rem}
.pc-num{font-family:'JetBrains Mono',monospace;font-size:.68rem;color:var(--text3);border:1px solid rgba(255,255,255,.06);padding:.22rem .6rem;border-radius:6px}
.pc-body{padding:0 2rem 2rem;flex:1;display:flex;flex-direction:column}
.pc-tags{display:flex;flex-wrap:wrap;gap:.35rem;margin-bottom:.85rem}
.pt{font-size:.67rem;padding:.2rem .65rem;border-radius:4px;background:rgba(99,102,241,.1);color:var(--c1l);font-family:'JetBrains Mono',monospace;border:1px solid rgba(99,102,241,.15)}
.pt.c{background:rgba(6,182,212,.08);color:var(--c2l);border-color:rgba(6,182,212,.15)}
.pt.p{background:rgba(244,114,182,.08);color:#f9a8d4;border-color:rgba(244,114,182,.15)}
h3.pc-title{font-size:1.1rem;font-weight:700;margin-bottom:.5rem;letter-spacing:-.01em}
.pc-desc{font-size:.86rem;color:var(--text2);line-height:1.75;flex:1;margin-bottom:1.1rem}
.pc-impact{display:inline-flex;align-items:center;gap:.4rem;font-size:.73rem;color:var(--c2l);background:rgba(6,182,212,.07);border:1px solid rgba(6,182,212,.15);border-radius:6px;padding:.28rem .7rem;margin-bottom:1.1rem;font-family:'JetBrains Mono',monospace}
.pc-links{display:flex;gap:.5rem}
.pl{flex:1;padding:.55rem;border-radius:8px;border:1px solid rgba(255,255,255,.08);color:var(--text2);text-align:center;font-size:.76rem;text-decoration:none;transition:all .3s;font-family:'JetBrains Mono',monospace}
.pl:hover{border-color:var(--c1);color:var(--c1l)}
.pl.m{background:var(--c1);color:#fff;border:none;font-weight:600}
.pl.m:hover{background:#5457d8;box-shadow:0 4px 20px rgba(99,102,241,.4)}

/* EXPERIENCE */
#experience{background:var(--bg)}
.exp-grid{display:grid;grid-template-columns:1fr 1fr;gap:4rem}
.exp-col-label{font-family:'JetBrains Mono',monospace;font-size:.74rem;color:var(--c1l);letter-spacing:.1em;text-transform:uppercase;margin-bottom:2rem;display:flex;align-items:center;gap:.6rem}
.exp-col-label::after{content:'';flex:1;height:1px;background:var(--border)}
.exp-col-label.edu-col{color:var(--c2l)}
.exp-col-label.edu-col::after{background:rgba(6,182,212,.2)}
.tl{position:relative;padding-left:1.5rem}
.tl::before{content:'';position:absolute;left:0;top:8px;bottom:0;width:1px;background:linear-gradient(to bottom,var(--c1),rgba(99,102,241,0))}
.tl.edu-tl::before{background:linear-gradient(to bottom,var(--c2),rgba(6,182,212,0))}
.tli{position:relative;margin-bottom:2.25rem}
.tl-dot{position:absolute;left:-1.5rem;top:4px;width:10px;height:10px;border-radius:50%;background:var(--c1);box-shadow:0 0 0 3px rgba(99,102,241,.2),0 0 12px rgba(99,102,241,.4)}
.edu-tl .tl-dot{background:var(--c2);box-shadow:0 0 0 3px rgba(6,182,212,.2),0 0 12px rgba(6,182,212,.4)}
.tl-date{font-family:'JetBrains Mono',monospace;font-size:.68rem;color:var(--c1l);margin-bottom:.3rem;letter-spacing:.05em}
.edu-tl .tl-date{color:var(--c2l)}
.tl-title{font-size:.98rem;font-weight:700;margin-bottom:.2rem;letter-spacing:-.01em}
.tl-org{font-size:.8rem;color:var(--text3);margin-bottom:.55rem;font-family:'JetBrains Mono',monospace}
.tl-desc{font-size:.84rem;color:var(--text2);line-height:1.75}
.tl-desc li{margin-bottom:.28rem;list-style:none;padding-left:.75rem;position:relative}
.tl-desc li::before{content:'→';position:absolute;left:-.1rem;color:var(--c1);font-size:.72rem;top:.05rem}
.edu-tl .tl-desc li::before{color:var(--c2)}

/* CERTIFICATIONS */
#certs{background:var(--bg2)}
.certs-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:1.1rem}
.cc{background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.06);border-radius:16px;padding:1.4rem;display:flex;gap:1rem;align-items:flex-start;transition:all .4s}
.cc:hover{border-color:rgba(99,102,241,.25);transform:translateY(-3px);background:rgba(99,102,241,.04)}
.cc-ico{width:42px;height:42px;border-radius:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:1.25rem;background:rgba(99,102,241,.12)}
.cc-prov{font-family:'JetBrains Mono',monospace;font-size:.63rem;color:var(--c1l);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.28rem}
.cc-name{font-size:.9rem;font-weight:600;margin-bottom:.22rem;line-height:1.4}
.cc-date{font-size:.72rem;color:var(--text3)}
.cc-link{display:inline-block;margin-top:.55rem;font-size:.7rem;color:var(--c1l);text-decoration:none;font-family:'JetBrains Mono',monospace;border-bottom:1px solid rgba(99,102,241,.3);transition:border-color .3s}
.cc-link:hover{border-color:var(--c1l)}

/* CONTACT */
#contact{background:var(--bg)}
.contact-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:4rem;align-items:start}
.ci-list{display:flex;flex-direction:column;gap:.8rem;margin-bottom:2rem}
.ci{display:flex;align-items:center;gap:.9rem;padding:1.05rem 1.2rem;background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.06);border-radius:12px;transition:all .4s}
.ci:hover{border-color:rgba(99,102,241,.2);background:rgba(99,102,241,.04)}
.ci-ico{width:36px;height:36px;border-radius:10px;flex-shrink:0;background:rgba(99,102,241,.12);display:flex;align-items:center;justify-content:center;font-size:.95rem}
.ci-lbl{font-size:.67rem;color:var(--text3);font-family:'JetBrains Mono',monospace;margin-bottom:.12rem}
.ci-val{font-size:.88rem;color:var(--text)}
.ci-val a{color:var(--c1l);text-decoration:none}
.avail{padding:.95rem 1.2rem;border-radius:12px;background:rgba(34,197,94,.05);border:1px solid rgba(34,197,94,.2);display:flex;align-items:center;gap:.7rem;font-size:.86rem;margin-bottom:2rem}
.av-dot{width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 8px #22c55e;animation:pulse 2s infinite;flex-shrink:0}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
.av-txt{color:#86efac}
.socials{display:flex;gap:.75rem}
